; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Domino Focus"
config/description="Xếp domino tỉ mỉ trong khi để mắt tới gió và mèo."
run/main_scene="res://scenes/main_3d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
; The web shell hardcodes the boot splash into an <img id="status-splash"> and
; holds it there for the whole 37 MB of wasm download, so on a first visit this
; picture IS the game for ten seconds or more - which is why it is now the room
; instead of the bare progress bar that used to sit here. The shell sizes it
; object-fit:contain, so the whole painting survives on every aspect ratio: no
; crop, and the lamp and the cat at the two edges both stay in frame.
boot_splash/image="res://assets/loading-splash.png"
; The room's Environment background colour, which is also what the contain
; letterbox fills with - so a wide monitor gets dark warm bars that read as the
; same room rather than as black bars. Still needed before the PNG arrives too.
boot_splash/bg_color=Color(0.09, 0.06, 0.05, 1)

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; The room is flat colours and hard silhouettes - no busy textures, no glinting
; shaders - so every bit of aliasing the game has is on a geometry edge, which is
; exactly and only what MSAA fixes. Measured on the crowded desk: 4x costs
; +0.18 ms/frame against a 16.7 ms budget, and 8x buys nothing visible over it.
anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=1
